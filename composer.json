{
  "name": "heliomarpm/linq-php",
  "description": "Manipulação fluida de arrays em PHP inspirada no LINQ: filtros, joins relacionais, agrupamentos e projeções com alta performance e zero dependências.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Heliomar P. Marques",
      "email": "heliomarpm@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/heliomarpm/linq-php/issues",
    "source": "https://github.com/heliomarpm/linq-php"
  },
  "keywords": [
    "linqphp",
    "linq",
    "linq2objects",
    "php-library",
    "collection",
    "array"
  ],
  "autoload": {
    "psr-4": {
      "HeliomarPM\\LinqPHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Benchmarks\\": "benchmarks/"
    }
  },
  "scripts": {
    "format": "pint --test --parallel --max-processes=4",
    "format:fix": "pint --parallel --max-processes=4 --repair --dirty",
    "format:full": "pint --parallel --max-processes=4 --repair",
    "format:def": "pint --preset=psr12 --parallel --max-processes=4 --repair",
    "lint": "phpstan analyse",
    "refactor": "rector process --dry-run",
    "refactor:apply": "rector process",
    "test": "phpunit --configuration phpunit.xml --colors=always",
    "test:v": "phpunit --configuration phpunit.xml --colors=always --debug",
    "test:coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --configuration phpunit.xml --colors=always --coverage-text",
    "test:coverage:html": "php -d xdebug.mode=coverage vendor/bin/phpunit --configuration phpunit.xml --coverage-html coverage/",
    "bench": "php ./benchmarks/run.php",
    "perform": "vendor/bin/phpbench run --report=aggregate",
    "demo": "php -S localhost:8000 -t ./demo",
    "check": [
      "@format",
      "@lint",
      "@refactor"
    ],
    "fix": [
      "@format:fix",
      "@refactor:apply"
    ],
    "qa": [
      "@test",
      "@bench",
      "@perform"
    ],
    "reset": [
      "rm -rf vendor composer.lock",
      "composer install"
    ]
  },
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpbench/phpbench": "^1.7",
    "phpstan/phpstan": "*",
    "laravel/pint": "^1.32",
    "rector/rector": "^2.7"
  }
}
